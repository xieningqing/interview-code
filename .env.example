# OpenAI API Key - Required for AI functionality
OPENAI_API_KEY="your-api-key-here"

# OpenAI-compatible endpoint (optional, default is OpenAI)
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

# Model name used for screenshot processing
OPENAI_MODEL="GLM-4.1V-Thinking-Flash"



# Programming Language Setting
# Supported languages: Java, Python, JavaScript, C++, etc.
APP_LANGUAGE="Java"
