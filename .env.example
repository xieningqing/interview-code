# OpenAI API Key - Required for AI functionality
OPENAI_API_KEY="your-api-key-here"

# OpenAI-compatible endpoint (optional, default is OpenAI)
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

# Model name used for screenshot processing
OPENAI_MODEL="GLM-4.1V-Thinking-Flash"

# Thinking / reasoning mode: "disabled" (default) or "enabled".
# Thinking models spend part of max_tokens on internal reasoning, which can leave
# no budget for the answer itself. Keep it disabled unless you need deeper reasoning.
OPENAI_THINKING="disabled"

# Maximum output tokens. Must comfortably fit the whole solution - a truncated
# response cannot be parsed as JSON. Raise this if solutions get cut off.
OPENAI_MAX_TOKENS="8192"



# Programming Language Setting
# Supported languages: Java, Python, JavaScript, C++, etc.
APP_LANGUAGE="Java"
